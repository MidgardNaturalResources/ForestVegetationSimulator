 {
  "id": "restart-fvs-7",
  "type": "regex_in_file",
  "doc": "Chapter 8: FVS jumps to calibration for restart code 7",
  "file": "base/fvs.f",
  "regex": "if\\s*\\(\\s*IRSTRTCD\\.eq\\.7\\s*\\)\\s*goto\\s+19"
 },
 {
  "id": "restart-fvs-1",
  "type": "regex_in_file",
  "doc": "Chapter 8: FVS jumps to TREGRO for restart codes 1 to 6",
  "file": "base/fvs.f",
  "regex": "if\\s*\\(\\s*IRSTRTCD\\.ge\\.1\\s*\\)\\s*goto\\s+41"
 },
 {
  "id": "restart-grincr",
  "type": "regex_in_file",
  "doc": "Chapter 8: GRINCR branches on the restart code",
  "file": "base/grincr.f",
  "regex": "GOTO\\s*\\(\\s*1,16,17,71,72,1\\s*\\)\\s*,\\s*ISTOPRES\\s*\\+\\s*1"
 },
 {
  "id": "restart-tregro",
  "type": "regex_in_file",
  "doc": "Chapter 8: TREGRO skips GRINCR for restart codes 5 and 6",
  "file": "base/tregro.f",
  "regex": "ISTOPRES\\.GE\\.5\\s+\\.and\\.\\s+\\.not\\.\\s+ISTOPRES\\.EQ\\.7"
 },
 {
  "id": "restart-gradd-5",
  "type": "regex_in_file",
  "doc": "Chapter 8: GRADD resumes at UPDATE for code 5",
  "file": "base/gradd.f",
  "regex": "IF\\s*\\(\\s*ISTOPRES\\.EQ\\.5\\s*\\)\\s*GOTO\\s+57"
 },
 {
  "id": "restart-gradd-6",
  "type": "regex_in_file",
  "doc": "Chapter 8: GRADD resumes after stop point 6 for code 6",
  "file": "base/gradd.f",
  "regex": "IF\\s*\\(\\s*ISTOPRES\\.EQ\\.6\\s*\\)\\s*GOTO\\s+97"
 },
 {
  "id": "clearrestart",
  "type": "regex_in_file",
  "doc": "Chapter 8: restart code cleared at the end of each cycle",
  "file": "base/fvs.f",
  "regex": "CALL\\s+ClearRestartCode\\s*\\n\\s*GOTO\\s+40"
 },
 {
  "id": "cuts-priority-1",
  "type": "regex_in_file",
  "doc": "Chapter 4: removal priority equation (size, species, value class, special status)",
  "file": "vbase/cuts.f",
  "regex": "WK2\\(I\\)\\s*=\\s*XSZ\\s*\\+\\s*IORDER\\(IS\\)\\s*\\+\\s*TCWT\\s*\\*\\s*IMC\\(I\\)\\s*\\+\\s*SPCLWT\\*ISPECL\\(I\\)"
 },
 {
  "id": "cuts-priority-2",
  "type": "regex_in_file",
  "doc": "Chapter 4: removal priority equation (point terms)",
  "file": "vbase/cuts.f",
  "regex": "PBAWT\\*PTBAA\\(IP\\)\\s*\\+\\s*PCCFWT\\*PCCF\\(IP\\)\\s*\\+\\s*PTPAWT\\*PTPA\\(IP\\)"
 },
 {
  "id": "cuts-priority-3",
  "type": "regex_in_file",
  "doc": "Chapter 4: mistletoe preference added to the priority",
  "file": "vbase/cuts.f",
  "regex": "IF\\(IDMR\\.GT\\.0\\)\\s*WK2\\(I\\)\\s*=\\s*WK2\\(I\\)\\s*\\+\\s*PRFMIS\\(IS,IDMR\\)"
 },
 {
  "id": "cuts-lbelow-reset",
  "type": "regex_in_file",
  "doc": "Chapter 4: LBELOW and LSPECL reset for each thinning request",
  "file": "vbase/cuts.f",
  "regex": "LBELOW\\s*=\\s*\\.FALSE\\.\\s*\\n\\s*LSPECL\\s*=\\s*\\.FALSE\\."
 },
 {
  "id": "cuts-field7",
  "type": "regex_in_file",
  "doc": "Chapter 4: field 7 of the density thinnings selects ranking and direction",
  "file": "vbase/cuts.f",
  "regex": "IF\\(ICUT\\s*\\.GT\\.\\s*0\\)\\s*LSPECL\\s*=\\s*\\.FALSE\\.\\s*\\n\\s*IF\\(ICUT\\s*\\.EQ\\.\\s*1\\)\\s*LBELOW\\s*=\\s*\\.TRUE\\."
 },
 {
  "id": "cuts-sort-bypass",
  "type": "regex_in_file",
  "doc": "Chapter 4: sort bypassed when LSPECL is true",
  "file": "vbase/cuts.f",
  "regex": "IF\\(LSPECL\\)\\s*GO TO 900"
 },
 {
