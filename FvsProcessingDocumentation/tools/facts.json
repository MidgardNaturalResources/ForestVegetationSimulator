  "doc": "Crown ratio dubbing: SN Weibull percent result",
  "file": "sn/crown.f",
  "regex": "CRNEW\\(I\\) = A \\+ B\\*\\(\\(-1\\.0\\*ALOG\\(1-X\\)\\)\\*\\*\\(1\\.0/C\\)\\)"
 },
 {
  "id": "crown-cs-twigs",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: CS TWIGS equation",
  "file": "cs/crown.f",
