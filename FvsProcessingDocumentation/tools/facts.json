  "regex": "IF\\(D\\.LT\\.1\\.0 \\.AND\\. LSTART\\) GO TO 58"
 },
 {
  "id": "crown-wc-scale",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: WC SCALE",
  "file": "wc/crown.f",
