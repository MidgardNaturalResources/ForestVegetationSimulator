 },
 {
  "id": "crown-ls-twigs",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: LS TWIGS equation",
  "file": "ls/crown.f",
  "regex": "CRNEW\\(I\\)=10\\*\\(BCR1\\(ISPC\\)/DEN\\+BCR3\\(ISPC\\)\\*\\(1-EXP\\(BCR4\\(ISPC\\)\\*D\\)\\)\\)"
 },
 {
  "id": "crown-ak-3pct",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: AK 3 percent increase bound",
  "file": "ak/crown.f",
  "regex": "IF\\(PDIFPY\\.GT\\.0\\.03\\)CHG=REAL\\(ICR\\(I\\)\\)\\*\\(0\\.03\\)\\*FINT"
 },
 {
  "id": "crown-ak-logistic",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: AK logistic",
  "file": "ak/crown.f",
  "regex": "\\+ B2 \\* LOG\\(H\\*12/D\\)"
 },
 {
  "id": "crown-wc-rw",
  "type": "regex_in_file",
  "doc": "Crown ratio dubbing: WC DUBSCR redwood equation",
  "file": "wc/dubscr.f",
  "regex": "-1\\.021064 \\+ 0\\.309296\\*LOG\\(HDR\\)"
 },
 {
  "id": "crown-sn-dubscr-dead",
